    "esbuild": "0.28.1",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "chokidar": "5.0.0",
    "fastify": "5.12.5",
    "fzstd": "^0.1.1",
    "kiwi-schema": "^0.5.0",
    "opentype.js": "^2.0.0",
    "parse5": "^8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
